#!/usr/bin/env bash
#
# Pre-commit checks for relay-cli. Install with `make hooks`, which installs
# every hook in this directory — commit-msg scans the message this one ignores.
#
# Ordered cheapest-first so a failure arrives fast. The credential check runs
# before anything else because it is the only one here guarding against a
# mistake you cannot take back: a secret pushed to a public repo is leaked the
# moment it lands, and rewriting history does not un-leak it.
#
# This is a fast local feedback loop, not a guarantee. It runs only on machines
# where someone ran `make hooks`, and `git commit --no-verify` skips it. The
# manual CI workflow (.github/workflows/ci.yml) is the backstop.

set -uo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1

# The hint wording, shared with commit-msg so the two cannot disagree. The
# shapes themselves are scripts/scan-secrets.sh's business.
. "$root/.githooks/lib.sh"

fail=0
note() { printf '  %s\n' "$1"; }
step() { printf '\n%s\n' "$1"; }

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# ── 1. credentials ───────────────────────────────────────────────────────────
step "checking for credentials"

# The live config lives in ~/.relay/config and so is never in a checkout — but a
# copy someone dropped in a repo to test with is exactly the accident worth
# catching, and `git add -f` bypasses any .gitignore.
if echo "$staged" | grep -qE '(^|/)(\.relay/config|\.worker-config)$'; then
	note "REFUSING: a relay-cli config is staged. Every relay_mcp in it is a live"
	note "credential. Unstage it: git restore --staged <path>"
	fail=1
fi

# Connector-shaped strings in ADDED lines only, so an existing placeholder in an
# untouched file costs nothing to check. The scanner allows placeholders by
# name; ci.yml and the pull-request check run the same one.
secrets=$(git diff --cached -U0 -- $(echo "$staged" | tr '\n' ' ') 2>/dev/null |
	grep '^+' | grep -vE '^\+\+\+' |
	"$root/scripts/scan-secrets.sh" || true)
if [ -n "$secrets" ]; then
	note "REFUSING: a connector-shaped secret is being added:"
	echo "$secrets" | sed 's/^/    /'
	note "$PLACEHOLDER_HINT"
	note "$REVOKE_HINT"
	fail=1
fi

[ "$fail" -eq 0 ] && note "ok"

# ── 1b. build output ─────────────────────────────────────────────────────────
#
# A binary committed by accident is pulled by every clone from then on, and a
# diff review does not notice a 10 MB file. Anything staged that is an
# executable image, or larger than any source file could be, is refused.
# repo_test.go is the backstop for a clone without the hooks.
step "checking for build output"
artefacts=""
while IFS= read -r f; do
	[ -z "$f" ] && continue
	size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
	magic=$(git show ":$f" 2>/dev/null | head -c 4 | od -An -tx1 | tr -d ' \n')
	case "$magic" in
		feedface|cefaedfe|feedfacf|cffaedfe|cafebabe|7f454c46) artefacts="$artefacts $f" ;;
		*) [ "$size" -gt 1048576 ] && artefacts="$artefacts $f" ;;
	esac
done <<EOF_STAGED
$staged
EOF_STAGED
if [ -n "$artefacts" ]; then
	note "REFUSING: a build output is staged:"
	for f in $artefacts; do echo "    $f"; done
	note "Unstage it: git restore --staged <path>, and add it to .gitignore."
	fail=1
else
	note "ok"
fi

# ── 2. gofmt ─────────────────────────────────────────────────────────────────
go_files=$(echo "$staged" | grep '\.go$' || true)
if [ -n "$go_files" ]; then
	step "gofmt"
	unformatted=$(gofmt -l $go_files 2>/dev/null)
	if [ -n "$unformatted" ]; then
		note "these staged files need gofmt:"
		echo "$unformatted" | sed 's/^/    /'
		note "fix with: gofmt -w $(echo "$unformatted" | tr '\n' ' ')"
		fail=1
	else
		note "ok"
	fi
fi

# ── 3. tests ─────────────────────────────────────────────────────────────────
#
# Without -race: this runs on every commit, and the point is a fast answer. CI
# runs the race detector.
#
# The tests include the documentation-drift checks, which is why adding a config
# field without documenting it fails here rather than shipping.
if echo "$staged" | grep -qE '\.go$|^go\.mod$'; then
	step "go test ./..."
	if out=$(go test ./... 2>&1); then
		note "ok"
	else
		echo "$out" | sed 's/^/    /'
		fail=1
	fi
fi

# A docs edit can break the drift tests without touching Go at all — and that
# now includes AGENTS.md and anything under docs/contributing/, because the link
# check walks every markdown file in the repo.
if echo "$staged" | grep -qE '\.md$'; then
	if ! echo "$staged" | grep -qE '\.go$'; then
		step "go test ./... (docs changed)"
		if out=$(go test ./... 2>&1); then
			note "ok"
		else
			echo "$out" | sed 's/^/    /'
			fail=1
		fi
	fi
fi

if [ "$fail" -ne 0 ]; then
	printf '\ncommit blocked. Fix the above, or bypass with: git commit --no-verify\n\n'
	exit 1
fi

printf '\nall pre-commit checks passed\n'
exit 0
